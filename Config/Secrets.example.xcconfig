// Copy this file to Config/Secrets.xcconfig and fill in the token.
//
//     cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Config/Secrets.xcconfig is git-ignored. The value is the same Storyblok
// *public* content delivery token the web app reads from
// NEXT_PUBLIC_STORYBLOK_TOKEN — never a preview or management token, since
// anything shipped in an app bundle is readable by anyone who downloads it.
STORYBLOK_ACCESS_TOKEN = REPLACE_ME

// published | draft
STORYBLOK_VERSION = published

// eu | usa | can | aus | chn
STORYBLOK_REGION = eu

// Note the `/$()/` escape: xcconfig treats `//` as a comment, and the empty
// variable reference breaks the sequence without changing the value.
SITE_ORIGIN = https:/$()/www.httpjpg.com
