// Build settings for the widget extension.
//
// Inherits the shared settings — including the git-ignored Secrets.xcconfig —
// so the extension reads the same Storyblok token from its own Info.plist.
#include "Shared.xcconfig"

PRODUCT_NAME = HttpjpgWidgets
PRODUCT_BUNDLE_IDENTIFIER = com.httpjpg.portfolio.widgets
INFOPLIST_FILE = HttpjpgWidgets/Info.plist

// The extension has no launch screen and no orientation of its own; clearing
// these keeps the generated plist from carrying app-only keys.
INFOPLIST_KEY_CFBundleDisplayName = httpjpg
INFOPLIST_KEY_UILaunchScreen_Generation =
INFOPLIST_KEY_UISupportedInterfaceOrientations =
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad =

ASSETCATALOG_COMPILER_APPICON_NAME =
SKIP_INSTALL = YES
