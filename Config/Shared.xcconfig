CONTENT_SOURCE = network

#include? "Secrets.xcconfig"

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = com.yl33ly.httpjpg
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 5.0

INFOPLIST_FILE = httpjpg/Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = httpjpg
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight

ASSETCATALOG_COMPILER_APPICON_NAME = httpjpg
ENABLE_USER_SCRIPT_SANDBOXING = YES
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = Config/App.entitlements

// The app group the app, the widget extension and the App Intents share a
// response and image cache through. Mirrored by the entitlement files, which
// cannot read an xcconfig variable.
APP_GROUP_IDENTIFIER = group.com.yl33ly.httpjpg

STORYBLOK_VERSION = published
STORYBLOK_REGION = eu
SITE_ORIGIN = https:/$()/www.httpjpg.com
TELEMETRYDECK_APP_ID =
